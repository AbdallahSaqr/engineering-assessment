generator client {
  provider = "prisma-client"
  output   = "../generated/client"
  moduleFormat = "esm"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Customer {
  id           String            @id
  name         String
  email        String            @unique
  phone        String
  applications LoanApplication[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

model LoanApplication {
  id                     String                    @id
  customerId             String
  customer               Customer                 @relation(fields: [customerId], references: [id])
  status                 String
  requestedAmountCents   Int
  currency               String                    @default("EGP")
  lastEventOccurredAt    DateTime?
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt
  history                ApplicationStatusHistory[]
  notificationJobs       NotificationJob[]

  @@index([customerId])
}

model ApplicationStatusHistory {
  id             String          @id
  applicationId  String
  application    LoanApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  status         String
  reason         String?
  sourceEventId  String?
  occurredAt     DateTime
  recordedAt     DateTime        @default(now())

  // Idempotency: one accepted partner event has exactly one effect on history.
  // Scoped to the application rather than global so that a partner reusing an
  // identifier across applications cannot suppress a legitimate event (DECISIONS.md D5).
  @@unique([applicationId, sourceEventId])
  @@index([applicationId, occurredAt])
  // Retained: the unique index above cannot serve a lookup by sourceEventId
  // alone, because it is not the leftmost column.
  @@index([sourceEventId])
}

model NotificationJob {
  id              String          @id
  applicationId   String
  application     LoanApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  sourceEventId   String
  type            String
  payload         String
  // Terminal state is a stored fact, not a value recomputed from the current
  // retry policy: raising the attempt limit must not resurrect dead jobs
  // (DECISIONS.md D10). One of PENDING, DELIVERED, DEAD_LETTERED.
  status          String          @default("PENDING")
  attemptCount    Int             @default(0)
  nextAttemptAt   DateTime?
  processedAt     DateTime?
  lastError       String?
  createdAt       DateTime        @default(now())

  // Idempotency: one accepted partner event requests at most one notification
  // of each type. Including `type` leaves room for an event to produce more than
  // one kind of notification later (DECISIONS.md D5).
  @@unique([applicationId, sourceEventId, type])
  @@index([status, nextAttemptAt])
  @@index([sourceEventId])
}
